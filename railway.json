{
  "builder": "railpacks",
  "build": {
    "installCommand": "cd laravel && composer install --no-interaction --no-dev --prefer-dist --optimize-autoloader && npm ci --include=dev",
    "buildCommand": "cd laravel && npm run build"
  },
  "deploy": {
    "preDeployCommand": "cd laravel && php artisan migrate --force",
    "startCommand": "cd laravel && php artisan serve --host=0.0.0.0 --port=$PORT",
    "healthcheckPath": "/",
    "restartPolicy": {
      "type": "on-failure",
      "maxRetries": 10
    }
  }
}