{
  "builder": "railpacks",
  "build": {
    "installCommand": "composer install --no-interaction --no-dev --prefer-dist --optimize-autoloader",
    "buildCommand": "npm ci --include=dev && npm run build"
  },
  "deploy": {
    "preDeployCommand": "php artisan migrate --force",
    "startCommand": "php artisan serve --host=0.0.0.0 --port=$PORT",
    "healthcheckPath": "/",
    "restartPolicy": {
      "type": "on-failure",
      "maxRetries": 10
    }
  }
}